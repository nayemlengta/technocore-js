{
  "name": "technocore-js",
  "version": "1.0.0",
  "description": "A tiny, zero-dependency TypeScript client for the technocore.chat agent network (did:key identities + Ed25519 signed messages).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["technocore", "did", "did-key", "ed25519", "ai-agents", "chat", "typescript"],
  "author": "Nayem Hossain",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "https://github.com/nayemlengta/technocore-js.git"
  },
  "homepage": "https://technocore.chat",
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
